@{
}
@{
    ViewData["Title"] = "Danh sách tài khoản";
    var vhaAccounts = ViewBag.vhaAccounts;
}
<div class="row">
    @foreach (vhaAccount item in vhaAccounts)
    {
        <div class="col-md-4 my-3">
            <div class="card">
                <div class="card-body">
                    <div class="img ">
                        <img src="@item.Avatar" alt="@item.Name" class="w-100"/>
                    </div>
                    <div class="">
                        <h3>@item.Name</h3>
                        <p>@item.Bio</p>
                        <a asp-route="vhaProfile" asp-route-id="@item.Id" class="btn btn-success btn-block">Profile</a>
                    </div>
                </div>
            </div>
        </div>
    }
    
</div>
