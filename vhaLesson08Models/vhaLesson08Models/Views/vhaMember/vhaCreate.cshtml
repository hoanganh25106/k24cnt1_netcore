@model vhaLesson08Models.Models.vhaMember

@{
    ViewData["Title"] = "Thêm mới thành viên";
}
<form asp-action="vhaCreate" method="post">
    <div class="card p-3">
        <div class="card-header">
            <h1>@ViewData["Title"]</h1>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="vhaMemberId" class="control-label"></label>
                        <input asp-for="vhaMemberId" class="form-control" />
                        <span asp-validation-for="vhaMemberId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="vhaUserName" class="control-label"></label>
                        <input asp-for="vhaUserName" class="form-control" />
                        <span asp-validation-for="vhaUserName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="vhaPassword" class="control-label"></label>
                        <input asp-for="vhaPassword" class="form-control" />
                        <span asp-validation-for="vhaPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="vhaFullName" class="control-label"></label>
                        <input asp-for="vhaFullName" class="form-control" />
                        <span asp-validation-for="vhaFullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="vhaEmail" class="control-label"></label>
                        <input asp-for="vhaEmail" class="form-control" />
                        <span asp-validation-for="vhaEmail" class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <div class="card-footer">
            <div class="form-group">
                <input type="submit" value="Ghi lại" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</form>
