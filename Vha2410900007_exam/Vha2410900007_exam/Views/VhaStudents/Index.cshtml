@model IEnumerable<Vha2410900007_exam.Models.VhaStudent>
@{
    ViewData["Title"] = "Index";
}

<h1 class="mb-4 text-primary">Index</h1>

<p>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Create New</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.VhaName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VhaGender)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VhaBirthDay)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VhaEmail)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VhaPhone)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VhaActive)
                </th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.VhaName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.VhaGender)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.VhaBirthDay)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.VhaEmail)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.VhaPhone)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.VhaActive)
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a> | 
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a> | 
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>