@{
}

@{
	ViewData["Title"] = "GetProduct";
}
<h1>GetProduct</h1>
<h2>Dữ liệu ấy từ ViewData</h2>
@{
	var productVD = ViewData["productVD"] as vhaLesson02Demo.Models.vhaProduct;
}
<div class="alert-danger">
	<p>Mã: @productVD.ProductId</p>
	<p>Tên: @productVD.ProductName</p>
	<p>Năm: @productVD.YearRelease</p>
	<p>Giá: @productVD.Price</p>
</div>
